// The program's icon and version details, which Windows shows in Explorer and the installer's list.
#include <winver.h>

IDI_ICON1 ICON "@PAPERTRAIL_ICO@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS VOS__WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Papertrail contributors"
            VALUE "FileDescription", "Papertrail"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "LegalCopyright", "GNU Affero General Public License v3.0 or later"
            VALUE "OriginalFilename", "papertrail.exe"
            VALUE "ProductName", "Papertrail"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
