<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0">
  <info>
    <title>Made-up Tiny Style</title>
    <id>http://example.org/styles/tiny</id>
    <updated>2026-11-19T00:00:00+00:00</updated>
  </info>
  <citation>
    <layout prefix="(" suffix=")" delimiter="; ">
      <names variable="author"><name form="short"/></names>
      <date variable="issued" prefix=" "><date-part name="year"/></date>
    </layout>
  </citation>
  <bibliography>
    <sort><key variable="title"/></sort>
    <layout>
      <names variable="author" suffix=". "><name and="text"/></names>
      <text variable="title" font-style="italic" suffix="."/>
      <text variable="volume" vertical-align="sup" prefix=" "/>
      <text variable="page" font-weight="bold" prefix=" "/>
    </layout>
  </bibliography>
</style>
